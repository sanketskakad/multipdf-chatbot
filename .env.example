# Primary: Groq API Key (Fast LLM Inference with llama-3.1-8b-instant)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Model Selection (Default: llama-3.1-8b-instant)
LLM_MODEL=llama-3.1-8b-instant

# Optional: OpenAI API Key (used for OpenAI embeddings or gpt models if specified)
OPENAI_API_KEY=your-openai-api-key-here
BASE_URL=https://api.openai.com/v1

# Optional: ChromaDB storage path (defaults to ./chroma_db)
# CHROMA_PERSIST_DIR=./chroma_db
